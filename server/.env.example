# ---------- Core ----------
PORT=8787
PUBLIC_URL=https://gaskin.example.ng
# Browser origins allowed to call the API (the hosted front end)
CORS_ORIGINS=https://app.gaskin.example.ng
TRUST_PROXY=true
# SQLite (default) or Postgres
DATABASE_URL=sqlite:/data/gaskin.db
# DATABASE_URL=postgres://gaskin:CHANGE_ME@postgres:5432/gaskin
# POSTGRES_PASSWORD=CHANGE_ME
DEFAULT_COUNTRY=NG
# Hours ahead of UTC for quiet hours (Nigeria and Ghana: 1 and 0; Kenya: 3)
TZ_OFFSET_HOURS=1
# First admin account: created on first start if no admin exists. Remove ADMIN_PIN afterwards.
ADMIN_PHONE=
ADMIN_PIN=
ADMIN_NAME=Programme administrator
# Salt for hashing IP addresses in the audit log (any long random string)
AUDIT_IP_SALT=

# ---------- Sign-in ----------
TOKEN_DAYS=30
PIN_MAX_ATTEMPTS=5
PIN_LOCK_MINUTES=15

# ---------- Messaging ----------
# sandbox: nothing real is sent (default). live: use the gateways below.
MESSAGING_MODE=sandbox
QUIET_HOURS=20-8
# Africa's Talking (SMS + voice). Username 'sandbox' uses AT's sandbox.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_VOICE_NUMBER=
# Termii (Nigeria SMS). Route 'dnd' reaches do-not-disturb numbers with an approved sender ID.
TERMII_API_KEY=
TERMII_SENDER_ID=Gaskin
TERMII_ROUTE=dnd
TERMII_WEBHOOK_SECRET=
# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=gaskin_care_update
WHATSAPP_TEMPLATE_LANGUAGE=en
# Email
SMTP_URL=
SMTP_FROM=Gaskin <care@gaskin.example.ng>

# ---------- AI (optional; Gaskin works fully without it) ----------
# Any OpenAI-compatible endpoint. Default recommendation: an open-weight model in-country.
# Ollama in this compose file: AI_BASE_URL=http://ollama:11434/v1  AI_MODEL=qwen2.5:7b-instruct
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# in_country | offshore: shown to users and in the public metrics
AI_RESIDENCY=in_country
AI_TIMEOUT_MS=60000

# ---------- Reporting ----------
SUPPRESS_BELOW=10
DHIS2_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_DATASET=
DHIS2_MAPPING_FILE=/data/dhis2-mapping.json
SOURCE_CODE_URL=https://github.com/gaskin-health/gaskin

# ---------- Retention (days unless stated) ----------
RETENTION_MESSAGE_BODY_DAYS=90
RETENTION_OPLOG_DAYS=180
RETENTION_AUDIT_DAYS=730
RETENTION_INACTIVE_YEARS=7
RETENTION_AUTO_DELETE=false
