{
  "name": "gaskin-server",
  "version": "0.1.0",
  "private": true,
  "description": "Gaskin hosted service: worker accounts, offline-first sync, messaging gateways, de-identifying AI proxy, DHIS2 export and public metrics.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "create-user": "tsx scripts/create-user.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "artifact-seed": "tsx scripts/artifact-seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "nodemailer": "^7.0.0"
  },
  "optionalDependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
